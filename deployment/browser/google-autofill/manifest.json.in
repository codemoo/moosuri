{
  "manifest_version": 3,
  "name": "Moosuri Vault",
  "description": "Use a selected vault login on the Google password page you choose.",
  "version": "1.0.0",
  "minimum_chrome_version": "114",
  "key": "",
  "action": { "default_title": "이 Google 로그인 화면에 선택한 비밀번호 입력" },
  "commands": { "_execute_action": { "suggested_key": { "default": "Alt+Shift+U" } } },
  "permissions": ["activeTab", "scripting"],
  "background": { "service_worker": "worker.js" },
  "externally_connectable": { "matches": ["VAULT_ORIGIN/*"] }
}
