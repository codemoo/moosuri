[Unit]
Description=Moosuri fresh member Google browser attempt

[Service]
User=root
UMask=0077
ExecStart=/usr/local/bin/moosuri runtime-google-browser --registry /var/lib/moosuri-control/registry --capsule-config /etc/moosuri/google-browser.json --gateway-uid 0 --public-origin ${MOOSURI_PUBLIC_ORIGIN} --client-file /var/lib/moosuri-control/registry/google-web-client.json
EnvironmentFile=/etc/moosuri/public-origin.env
StandardInput=socket
StandardOutput=null
StandardError=null
RuntimeMaxSec=24min
TimeoutStopSec=175
NoNewPrivileges=yes
ProtectSystem=full
ProtectHome=true
