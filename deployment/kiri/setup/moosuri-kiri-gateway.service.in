[Unit]
Description=Moosuri member gateway (clean Kiri installation)
After=kiri.service moosuri-kiri-model.service moosuri-kiri-lifecycle.service
Wants=kiri.service

[Service]
Type=simple
User=root
Group=@PROXY_GID@
UMask=0077
RuntimeDirectory=moosuri-member-proxy
RuntimeDirectoryMode=0710
RuntimeDirectoryPreserve=yes
ExecStart=/usr/local/bin/moosuri personal-gateway --public-origin @PUBLIC_ORIGIN@ --vault-site-origin @VAULT_ORIGIN@ --registry /var/lib/moosuri-control/registry --ipc-root /srv/moosuri-storage/ipc --socket-dir /var/lib/moosuri-control/gateway --proxy-socket-dir /run/moosuri-member-proxy --proxy-gid @PROXY_GID@ --vault-all-members --vault-adapter-listen @GATEWAY_ADAPTER@ --vault-adapter-key-file /etc/moosuri/vault-adapter.key --google-runtime-socket /run/moosuri-google-browser/runtime.sock --google-runtime-installation @INSTALLATION_ID@ --model-setup --model-setup-dir /var/lib/moosuri-control/model-setup --onboard-config /etc/moosuri/kiri-members.json --onboard-policy /etc/moosuri/kiri-onboard-policy.json --onboard-operations-root /var/lib/moosuri-control/invitations
Restart=on-failure
RestartSec=3
TimeoutStopSec=30
NoNewPrivileges=yes
ProtectSystem=full
ProtectHome=true

[Install]
WantedBy=multi-user.target
