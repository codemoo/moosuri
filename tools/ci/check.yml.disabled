name: Plan and specification checks

on:
  pull_request:
  push:
    branches: [main]

permissions:
  contents: read

jobs:
  check:
    runs-on: ubuntu-24.04
    timeout-minutes: 10
    env:
      OPENSPEC_TELEMETRY: "0"
      CARGO_TERM_COLOR: always
    steps:
      - uses: actions/checkout@11bd71901bbe5b1630ceea73d27597364c9af683 # v4.2.2
        with:
          persist-credentials: false
      - uses: actions/setup-node@49933ea5288caeca8642d1e84afbd3f7d6820020 # v4.4.0
        with:
          node-version: "22.22.0"
      - name: Install pinned contributor tools
        run: |
          rustup toolchain install 1.88.0 --profile minimal --component rustfmt
          npm ci --ignore-scripts --no-audit --no-fund --prefix tools/openspec
      - name: Check the Rust plan verifier
        run: |
          cargo +1.88.0 fmt --all --check
          cargo +1.88.0 check --locked --all-targets
          cargo +1.88.0 run --locked -p xtask -- verify-plan
      - name: Validate OpenSpec artifacts
        run: tools/openspec/node_modules/.bin/openspec validate --all --strict --no-interactive
