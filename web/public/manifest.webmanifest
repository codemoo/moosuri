{
  "id": "/app",
  "name": "moosuri — 무수리",
  "short_name": "무수리",
  "description": "나와 가족을 위한 개인 비서",
  "start_url": "/app",
  "scope": "/",
  "display": "standalone",
  "background_color": "#101113",
  "theme_color": "#101113",
  "lang": "ko",
  "icons": [
    { "src": "/moosuri-icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "/moosuri-icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" }
  ],
  "share_target": {
    "action": "/share-target",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url",
      "files": [{
        "name": "files",
        "accept": ["image/png", "image/jpeg", "image/webp", "text/plain", "text/markdown", "text/csv", "application/json", "application/pdf", "audio/wav", "audio/mpeg", "audio/mp4", "audio/ogg", "audio/webm", "audio/aac", "audio/flac", ".txt", ".md", ".csv", ".json", ".pdf", ".m4a"]
      }]
    }
  }
}
